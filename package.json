{
  "name": "spotted-london",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:local": "wrangler dev --port 8787 --local",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply spotted-db --local",
    "db:seed": "wrangler d1 execute spotted-db --local --file=./seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "recategorize": "node scripts/recategorize.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "usage": "node scripts/usage.mjs",
    "types": "wrangler types",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "postinstall": "npm --prefix web install",
    "pretest": "npm run build:web"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "wrangler": "^4.145.0",
    "vitest": "^4.1.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
