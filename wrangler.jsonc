{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manyfold-spotted-london",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  // Shared host app.manyfold.ai: one route on the manyfold.ai zone, neither reaching past /spotted-london.
  // The trailing * matters: Cloudflare matches a route pattern against the whole URL including the query string,
  // so a plain "app.manyfold.ai/spotted-london" misses ".../spotted-london?fbclid=..." (the Instagram bio link),
  // which then falls through to the shared host's origin and shows error 1033.
  // Keep it in step with BASE_PATH below and "run_worker_first" in `assets`.
  "routes": [
    { "pattern": "app.manyfold.ai/spotted-london*", "zone_name": "manyfold.ai" }
  ],
  "observability": { "enabled": true },

  // The web app (web/dist). Unknown paths fall back to index.html; these paths run the Worker first.
  // The last two are for the mount at app.manyfold.ai/spotted-london (BASE_PATH, src/mount.ts): the prefix has to
  // come off before the static files can be found, so everything under it goes to the Worker first.
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login/*", "/p/*", "/mcp", "/llms.txt", "/privacy", "/sitemap.xml", "/robots.txt", "/spotted-london", "/spotted-london/*"]
  },

  // Safe default. Local dev switches to "development" through .dev.vars.
  "vars": {
    "ENVIRONMENT": "production",
    // Public site address with its mount path, used in sign-in links and the Google redirect. Set before deploying.
    "APP_URL": "https://app.manyfold.ai/spotted-london",
    // The site is served under this prefix on the shared host app.manyfold.ai (src/mount.ts, the `routes` below).
    // Requests that arrive at the root of another host, such as the workers.dev address, are still answered.
    "BASE_PATH": "/spotted-london",
    // Public Turnstile site key (the secret goes in `wrangler secret put TURNSTILE_SECRET`)
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFVejc0-TdzlZmEU",
    // The usage guard (src/db/usage.ts) looks these two up in Cloudflare's analytics. Its secrets are CF_ACCOUNT_ID and
    // CF_ANALYTICS_TOKEN (Account Analytics: Read). Keep them in step with the bindings below.
    "USAGE_D1_ID": "8116bcdf-bf87-4e8c-9dcf-93fa80000b2a",
    "USAGE_R2_BUCKET": "manyfold-spotted-london-images",
    "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Reads screenshots. Takes images as base64 data URIs and supports JSON schema output.
    "AI_VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    // Google Analytics 4 (stream "Spotted London"), on production pages at APP_URL's host only (src/analytics.ts).
    // Visitors in the UK, the EEA and Switzerland are asked first. Left out of `previews` on purpose: previews are
    // not measured. Remove it and no page loads anything from Google.
    "GA_MEASUREMENT_ID": "G-P9WVSTMG87"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "manyfold-spotted-london-db", "database_id": "8116bcdf-bf87-4e8c-9dcf-93fa80000b2a", "migrations_dir": "./migrations" }
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "bba61c97b91a4980af0cdfc40ca3d8cf" }],
  // Anyone's AI assistant can call POST /mcp without a key (search_popups, get_popup). This caps those calls per
  // visitor (a salted IP hash) so one client cannot use up the free CPU. Counted by Cloudflare, no D1 or KV writes.
  "ratelimits": [{ "name": "MCP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  // Anonymous usage events (src/routes/events.ts). Written with no D1 or KV cost; the Insights page reads them back
  // through the Analytics Engine SQL API (secrets CF_ACCOUNT_ID and CF_ANALYTICS_TOKEN, see README "Insights").
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "spotted_events" }],
  // Photos (R2 enabled on the account on 2026-09-30)
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "manyfold-spotted-london-images" }],

  // Workers AI for autofill from pasted text and screenshots. It always runs on Cloudflare,
  // so `npm run dev` needs `npx wrangler login` first. Free tier: 10,000 neurons a day.
  "ai": { "binding": "AI", "remote": true },

  // Branch builds on Workers Builds run `wrangler preview`, which needs its own copy of the
  // vars and bindings. Previews share production data (see README "How deploys happen").
  // Secrets are not copied: without TURNSTILE_SECRET, writes that need the bot check return
  // 501, and Google sign in is off. Add them with `npx wrangler preview secret put` if needed.
  "previews": {
    "vars": {
      "ENVIRONMENT": "production",
      "APP_URL": "https://app.manyfold.ai/spotted-london",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFVejc0-TdzlZmEU",
      "USAGE_D1_ID": "8116bcdf-bf87-4e8c-9dcf-93fa80000b2a",
      "USAGE_R2_BUCKET": "manyfold-spotted-london-images",
      "AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "AI_VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
    },
    "d1_databases": [{ "binding": "DB", "database_name": "manyfold-spotted-london-db", "database_id": "8116bcdf-bf87-4e8c-9dcf-93fa80000b2a" }],
    "kv_namespaces": [{ "binding": "CACHE", "id": "bba61c97b91a4980af0cdfc40ca3d8cf" }],
    "ratelimits": [{ "name": "MCP_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
    "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "spotted_events" }],
    "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "manyfold-spotted-london-images" }],
    "ai": { "binding": "AI" }
  },

  "triggers": {
    "crons": [
      "*/10 * * * *", // end expired pop-ups, start and check agent runs, fetch Instagram/Threads posts
      "0 * * * *",    // recompute hot (only rows that moved), reminders
      "0 4 * * *"     // settle karma, abuse scan, purge old check-in coordinates
    ]
  }
}
