ENVIRONMENT=development
APP_URL=http://localhost:5173
IP_SALT=local-dev-salt
# Optional in development. Without them, sign-in links are returned in the API response.
# RESEND_API_KEY=
# EMAIL_FROM=Spotted London <hello@your-domain>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TURNSTILE_SECRET=
# MAPBOX_TOKEN=
# Encrypts the Manyfold caller tokens of the AI agents (32+ characters). Needed for /admin/agent.
AGENTS_KEY=local-dev-agents-key-at-least-32-chars
